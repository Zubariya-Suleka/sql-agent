# Copy to .env. Never commit .env. These are local-only defaults: Postgres listens on
# 127.0.0.1 only. Use 127.0.0.1, not localhost (from Windows, localhost tries IPv6 first,
# which WSL's port forwarding accepts but never answers).

# Postgres container (docker-compose.yml)
POSTGRES_PASSWORD=olist-dev
# Reuse an image already in your Docker engine instead of pulling postgres:17:
# POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17

# Owner role: the loader creates the schema, loads the CSVs and (re)creates agent_ro.
ADMIN_DATABASE_URL=postgresql://olist_admin:olist-dev@127.0.0.1:5433/olist
# Read-only role the agent runs as (SELECT on schema olist only, 5 s statement timeout).
AGENT_RO_PASSWORD=agent-ro-dev
DATABASE_URL=postgresql://agent_ro:agent-ro-dev@127.0.0.1:5433/olist
